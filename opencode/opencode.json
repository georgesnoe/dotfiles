{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": "notify",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".idea/**",
      "node_modules/**",
      "__pycache__/**",
      ".next/**",
      ".gradle/**",
      ".tanstack/**",
      "dist/**",
      "build/**",
      ".output/**"
    ]
  },
  "instructions": [
    "CLAUDE.md",
    "AGENTS.md",
    "DESIGN.md",
    "STYLE.md",
    "PLAN.md"
  ],
  "provider": {
    "openrouter": {
      "options": {
        "chunkTimeout": 30000,
        "timeout": false,
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "ollama-cloud": {
      "options": {
        "chunkTimeout": 30000,
        "timeout": false,
        "apiKey": "{env:OLLAMA_API_KEY}"
      }
    }
  },
  "username": "georgesnoe",
  "model": "openrouter/google/gemma-4-31b-it:free",
  "small_model": "openrouter/google/gemma-4-26b-a4b-it:free"
}
